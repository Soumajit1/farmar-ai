<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AgriLink AI â€” Login</title>
<link rel="stylesheet" href="css/style.css">
<style>
  /* Page specific styles for Login split screen */
  .login-page {
    display: flex;
    min-height: 100vh;
    width: 100%;
  }

  .visual-side {
    flex: 1;
    background: linear-gradient(135deg, #004d40, #1b5e20);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: white;
    padding: 40px;
  }

  /* 3D Visual Concept (CSS Only) */
  .scene-3d {
    position: absolute;
    width: 100%;
    height: 100%;
    perspective: 1000px;
    z-index: 0;
  }

  .node {
    position: absolute;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    backdrop-filter: blur(5px);
    border-radius: 12px;
    animation: float 6s infinite ease-in-out alternate;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }

  .node-1 { width: 120px; height: 120px; top: 20%; left: 15%; transform: translateZ(-50px) rotateY(15deg); animation-delay: 0s; }
  .node-2 { width: 180px; height: 120px; top: 50%; right: 20%; transform: translateZ(50px) rotateY(-20deg); animation-delay: -2s; }
  .node-3 { width: 100px; height: 100px; bottom: 15%; left: 30%; transform: translateZ(100px) rotateX(20deg); animation-delay: -4s; }

  /* Overlay text */
  .visual-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 500px;
  }

  .visual-content h1 {
    font-size: 48px;
    margin-bottom: 16px;
    background: linear-gradient(to right, #fff, #a5d6a7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .visual-content p {
    font-size: 18px;
    line-height: 1.6;
    color: #e8f5e9;
    opacity: 0.9;
  }

  /* Form Side */
  .form-side {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f4f7f6;
    position: relative;
  }

  /* Subtle background pattern for form side */
  .form-side::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image: radial-gradient(var(--color-primary-light) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0.05;
  }

  .login-card-container {
    width: 100%;
    max-width: 480px;
    padding: 0 24px;
    z-index: 1;
  }

  .role-selector {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
    flex-wrap: wrap;
    background: rgba(255,255,255,0.5);
    padding: 6px;
    border-radius: var(--border-radius-md);
    box-shadow: inset 0 2px 5px rgba(0,0,0,0.02);
  }

  .role-btn {
    flex: 1;
    padding: 12px 6px;
    border: none;
    background: transparent;
    color: var(--text-muted);
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    font-family: 'Outfit', sans-serif;
    font-size: 14px;
    font-weight: 600;
    transition: all var(--transition-fast);
  }

  .role-btn.active {
    background: var(--bg-surface);
    color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .forgot-link {
    font-size: 13px;
    font-weight: 500;
  }

  .form-options {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .switch-text {
    text-align: center;
    font-size: 14px;
    margin-top: 24px;
  }

  .error-msg {
    color: #e74c3c;
    font-size: 13px;
    text-align: center;
    margin-bottom: 16px;
    min-height: 16px;
  }

  @media (max-width: 900px) {
    .login-page {
      flex-direction: column;
    }
    .visual-side {
      min-height: 300px;
      flex: none;
    }
    .form-side {
      padding: 40px 0;
    }
  }

/* ==================================================
   FEEDBACK & GRIEVANCE
================================================== */

.support-options {
  display: flex;
  gap: 12px;
  margin-top: 18px;
}

.support-option {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  background: rgba(255,255,255,0.75);
  border: 1px solid rgba(0,77,64,0.1);
  border-radius: 10px;
  text-decoration: none;
  color: var(--text-main);
  transition: all 0.2s ease;
}

.support-option:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-sm);
}

.support-icon {
  width: 32px;
  height: 32px;
  min-width: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e8f5e9;
  color: #1b5e20;
  font-weight: 700;
}

.support-option strong {
  display: block;
  font-size: 13px;
}

.support-option small {
  display: block;
  margin-top: 2px;
  color: var(--text-muted);
  font-size: 11px;
}


@media (max-width: 500px) {

  .support-options {
    flex-direction: column;
  }

  .project-logo-sih {
    width: 160px;
  }

  .project-logo-syntex {
    width: 70px;
    height: 70px;
  }
}

/* SyntexSparks logo - top left */
.syntex-logo-top-left {
  position: absolute;
  top: 24px;
  left: 24px;
  z-index: 5;
  padding: 8px 12px;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 12px;
  backdrop-filter: blur(8px);
}

.syntex-logo-top-left img {
  width: 90px;
  height: auto;
  display: block;
  object-fit: contain;
}

@media (max-width: 500px) {
  .syntex-logo-top-left {
    top: 16px;
    left: 16px;
  }

  .syntex-logo-top-left img {
    width: 70px;
  }
}

/* ==================================================
   AGRILINK AI MAIN LOGO
================================================== */

.main-agrilink-logo {
  position: relative;
  z-index: 3;

  display: flex;
  align-items: center;
  justify-content: center;

  width: min(430px, 90%);
  min-height: 150px;

  margin: 0 auto 24px;

  padding: 20px 28px;

  background: rgba(255, 255, 255, 0.96);

  border-radius: 24px;

  box-shadow:
    0 18px 45px rgba(0, 0, 0, 0.20);

  border:
    1px solid rgba(255, 255, 255, 0.9);

  backdrop-filter: blur(10px);

  animation:
    logoFloat 5s ease-in-out infinite;
}

.main-agrilink-logo img {
  width: 100%;
  max-width: 360px;
  height: auto;

  display: block;

  object-fit: contain;
}


/* ==================================================
   FEEDBACK + GRIEVANCE
================================================== */

.homepage-support {
  position: absolute;

  top: 24px;
  left: 24px;

  z-index: 10;

  display: flex;
  flex-direction: column;

  gap: 8px;

  width: 170px;
}

.homepage-support-btn {
  display: flex;

  align-items: center;

  gap: 9px;

  padding: 9px 11px;

  color: #ffffff;

  text-decoration: none;

  background: rgba(255, 255, 255, 0.10);

  border:
    1px solid rgba(255, 255, 255, 0.20);

  border-radius: 10px;

  backdrop-filter: blur(10px);

  transition:
    transform 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

.homepage-support-btn:hover {
  transform: translateY(-2px);

  background:
    rgba(255, 255, 255, 0.18);

  box-shadow:
    0 8px 20px rgba(0, 0, 0, 0.15);
}

.support-btn-icon {
  width: 27px;
  height: 27px;

  min-width: 27px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #ffffff;

  color: #1b5e20;

  font-size: 13px;

  font-weight: 700;
}

.homepage-support-btn strong {
  display: block;

  font-size: 12px;

  line-height: 1.2;
}

.homepage-support-btn small {
  display: block;

  margin-top: 2px;

  font-size: 9px;

  color: #dcedc8;
}


/* ==================================================
   LOGO ANIMATION
================================================== */

@keyframes logoFloat {

  0% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-5px);
  }

  100% {
    transform: translateY(0);
  }

}


/* ==================================================
   MOBILE
================================================== */

@media (max-width: 900px) {

  .homepage-support {
    position: relative;

    top: auto;
    left: auto;

    width: min(430px, 90%);

    flex-direction: row;

    margin: 0 auto 20px;
  }

  .homepage-support-btn {
    flex: 1;
  }

  .main-agrilink-logo {
    width: min(430px, 90%);

    min-height: 120px;

    padding: 18px;
  }

}


@media (max-width: 500px) {

  .homepage-support {
    flex-direction: column;
  }

  .main-agrilink-logo {
    min-height: 100px;

    padding: 15px;
  }

  .main-agrilink-logo img {
    max-width: 280px;
  }

}
</style>
</head>
<body>

  <div class="login-page">
    
    <!-- 3D Visual Side -->
    <div class="visual-side">
      <div class="scene-3d">
        <div class="node node-1"></div>
        <div class="node node-2"></div>
        <div class="node node-3"></div>
      </div>
      
      <div class="main-agrilink-logo">
        <img
          src="images/image100.png"
          alt="AgriLink AI"
        >
      </div>
        <h1>AgriLink AI</h1>
        <p>Smart Market Intelligence & Farmer Buyer Linkage</p>
</div>
    </div>

    <!-- Form Side -->
    <div class="form-side">
      <div class="login-card-container">
        
        <div class="card-3d" style="padding: 40px 32px; background: rgba(255,255,255,0.85); backdrop-filter: blur(20px);">
          <h2 style="font-size: 28px; margin-bottom: 8px; color: var(--text-main);">Welcome Back</h2>
          <p style="color: var(--text-muted); margin-bottom: 32px;">Please enter your details to sign in.</p>

          <!-- Role Selector -->
          <div class="role-selector">
            <button class="role-btn active" data-role="farmer">Farmer</button>
            <button class="role-btn" data-role="buyer">Buyer</button>
<button class="role-btn" data-role="admin">Admin</button>
          </div>

          <form id="loginForm">
            <div class="input-group">
              <label for="identifier">Mobile Number / Email</label>
              <input type="text" id="identifier" placeholder="Enter mobile number or email" required>
            </div>

            <div class="input-group">
              <label for="password">Password</label>
              <input type="password" id="password" placeholder="Enter password" required>
            </div>

            <p class="error-msg" id="errorMsg"></p>

            <div class="form-options">
              <label style="display: flex; align-items: center; gap: 8px; font-size: 14px; cursor: pointer;">
                <input type="checkbox" id="remember" style="width: 16px; height: 16px;"> Remember me
              </label>
              <a href="#" class="forgot-link">Forgot password?</a>
            </div>

            <button type="submit" class="btn-primary" style="width: 100%;">
              Sign In 
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </button>
          </form>

          <p class="switch-text">
            New here? <a href="register.html" style="font-weight: 600;">Create an account</a>
          </p>
        </div>

      </div>
    </div>

  </div>

  <script src="js/auth.js"></script>
</body>
</html>






